{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "keywords": [],
  "author": "Anastasiia",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "scripts": {
    "start": "nodemon server.ts",
    "build": "tsc -p tsconfig.build.json --noEmit false --outDir dist --rewriteRelativeImportExtensions",
    "typecheck": "tsc --noEmit",
    "migration:generate": "tsx --env-file=.env ../node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "migration:create": "tsx ../node_modules/typeorm/cli.js migration:create",
    "migration:run": "tsx --env-file=.env ../node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:revert": "tsx --env-file=.env ../node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "start:users": "nodemon users-service.ts",
    "start:logger": "nodemon logging-service.ts",
    "test": "node --env-file-if-exists=.env.test --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --env-file-if-exists=.env.test --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "nodemonConfig": {
    "ext": "ts,json",
    "exec": "tsx --env-file=.env",
    "ignore": [
      "**/test/**",
      "**/docs/**",
      "data/*",
      "swagger.json",
      "**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "npm": "^12.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.3",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  }
}
